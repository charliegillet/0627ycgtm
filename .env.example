# ─────────────────────────────────────────────────────────────────────────────
# BEACHHEAD (Horizon × Orange Slice × Fiber AI) — environment template
# Copy to `.env.local` (Next.js) and/or `.env` (Convex/Python) and fill in.
# NEVER commit the filled file. `.env*` is gitignored.
# Vars prefixed NEXT_PUBLIC_* are exposed to the browser — keep secrets unprefixed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex (realtime spine) ──────────────────────────────────────────────────
# Set automatically by `npx convex dev` on first run; do not hand-edit CONVEX_DEPLOYMENT.
CONVEX_DEPLOYMENT=                       # e.g. dev:harmonious-otter-123 (managed by convex CLI)
NEXT_PUBLIC_CONVEX_URL=                  # https://<deployment>.convex.cloud  (browser client)
CONVEX_URL=                             # same .convex.cloud URL, for server/Python orchestrator
# CONVEX_SITE_URL=                       # https://<deployment>.convex.site  (HTTP actions / webhooks)

# ── OpenAI (scoring + embeddings) ────────────────────────────────────────────
# Used by ai.generateObject-style scoring and text-embedding-3-small (1536-d vectors).
OPENAI_API_KEY=                         # https://platform.openai.com/api-keys

# ── Orange Slice (B2B data toolbelt: funding / firmographics / signals) ──────
# Get via `npx orangeslice login` (writes ~/.config/orangeslice/config.json) OR set this.
ORANGESLICE_API_KEY=                     # https://www.orangeslice / `npx orangeslice auth <KEY>`

# ── Fiber AI (B2B data: hiring / social / contact reveal / live LinkedIn) ────
# Read by the SDK / direct curl. Auth header: `Authorization: Bearer $FIBER_API_KEY`.
FIBER_API_KEY=                          # https://www.fiber.ai/sign-in

# ── Browser Use (live-iframe "watch agents work" demo path) ──────────────────
BROWSER_USE_API_KEY=                     # https://browser-use.com  (cloud sessions + live_url)
BROWSER_USE_PROFILE_IDS=                 # comma-separated cloud profile ids (logged-in profiles)

# ── ACT layer (non-email outreach) ───────────────────────────────────────────
# Slack is the cleanest non-email ACT. Either use a direct webhook OR Orange Slice's
# integrations.slack OAuth (then this is not needed). Pick one.
SLACK_WEBHOOK_URL=                       # https://api.slack.com/messaging/webhooks  (optional)
# HUBSPOT_API_KEY=                        # optional CRM ACT target
# ATTIO_API_KEY=                          # optional CRM ACT target

# ── Observability (optional) ─────────────────────────────────────────────────
LMNR_PROJECT_API_KEY=                    # https://www.lmnr.ai  (Laminar tracing — optional)

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
